def main(args: argparse.Namespace) -> int:

    #           0.1.    OBTAIN GLOBAL VARIABLES.
    operation_mode          : cc.OperationMode      = globals().get( "_OPERATION_MODE"      , None )


    #           0.2.    VARIABLE DEFINITIONS.
    exit_code               : int                   = 0


    #           0.3.    ASSERTIONS / DEFENSIVE STATEMENTS.
    assert (args is not None)


    #           0.4.    VARIABLE ASSIGNMENTS  [ AFTER ASSERTIONS ].
    simulated_mode          = bool(args.mock) or (not _HARDWARE_AVAILABLE)



    #   1.      DETERMINE SCRIPT OPERATION MODE...
    if not simulated_mode:
        try:
            with Session(bitfile=BITFILE, resource=RESOURCE) as _tmp:
                pass
        except Exception as e:
            sys.stderr.write(f"Hardware open failed: {e}.  Falling back to simulated.\n")
            simulated_mode = True

    operation_mode          = cc.OperationMode.Simulated if (simulated_mode)    else cc.OperationMode.Hardware



    #   2.      DISPATCH MAIN FUNCTION...
    match operation_mode:
        #
        #   CASE 1          : REAL HARDWARE...
        case cc.OperationMode.Simulated:
            exit_code = _main_simulation()
        #
        #   CASE 2          : SIMULATED OUTPUT...
        case cc.OperationMode.Hardware:
            sys.stderr.write("`fpga_stream` operating in `simulated` mode.\n")
            sys.stderr.flush()
            exit_code = _main_hardware()
        #
        #
        #
        #   DEFAULT CASE :
        case _:
            sys.stderr.write(f"Unknown OperationMode: {operation_mode}\n")
            exit_code = 1



    return exit_code



